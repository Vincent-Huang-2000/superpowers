digraph STYLE_GUIDE {
    // 这份流程 DSL 的风格指南用 DSL 本身写成。

    // 节点类型及对应形状示例
    subgraph cluster_node_types {
        label="节点类型及形状";

        // 问题用菱形
        "Is this a question?" [label="这是一个问题吗?", shape=diamond];

        // 操作用方框（默认）
        "Take an action" [label="执行操作", shape=box];

        // 命令用纯文本
        "git commit -m 'msg'" [shape=plaintext];

        // 状态用椭圆
        "Current state" [label="当前状态", shape=ellipse];

        // 警告用八边形
        "STOP: Critical warning" [label="停止！重要警告", shape=octagon, style=filled, fillcolor=red, fontcolor=white];

        // 起点和终点用双圆
        "Process starts" [label="流程开始", shape=doublecircle];
        "Process complete" [label="流程完成", shape=doublecircle];

        // 各类型示例
        "Is test passing?" [label="测试通过了吗?", shape=diamond];
        "Write test first" [label="先写测试", shape=box];
        "npm test" [shape=plaintext];
        "I am stuck" [label="遇到阻碍", shape=ellipse];
        "NEVER use git add -A" [label="严禁使用 git add -A", shape=octagon, style=filled, fillcolor=red, fontcolor=white];
    }

    // 连线的命名约定
    subgraph cluster_edge_types {
        label="连线标签";

        "Binary decision?" [label="是非判断?", shape=diamond];
        "Yes path" [label="是分支", shape=box];
        "No path" [label="否分支", shape=box];

        "Binary decision?" -> "Yes path" [label="是"];
        "Binary decision?" -> "No path" [label="否"];

        "Multiple choice?" [label="有多个选项?", shape=diamond];
        "Option A" [label="选项 A", shape=box];
        "Option B" [label="选项 B", shape=box];
        "Option C" [label="选项 C", shape=box];

        "Multiple choice?" -> "Option A" [label="条件 A"];
        "Multiple choice?" -> "Option B" [label="条件 B"];
        "Multiple choice?" -> "Option C" [label="其他情况"];

        "Process A done" [label="流程 A 完成", shape=doublecircle];
        "Process B starts" [label="流程 B 开始", shape=doublecircle];

        "Process A done" -> "Process B starts" [label="触发", style=dotted];
    }

    // 命名模式
    subgraph cluster_naming_patterns {
        label="命名模式";

        // 问题以 ? 结尾
        "Should I do X?" [label="是否应该做 X?"];
        "Can this be Y?" [label="这可能是 Y 吗?"];
        "Is Z true?" [label="Z 为真吗?"];
        "Have I done W?" [label="已经做过 W 了吗?"];

        // 操作以动词开头
        "Write the test" [label="编写测试"];
        "Search for patterns" [label="搜索模式"];
        "Commit changes" [label="提交改动"];
        "Ask for help" [label="寻求帮助"];

        // 命令按原样书写
        "grep -r 'pattern' .";
        "git status";
        "npm run build";

        // 状态描述当前情况
        "Test is failing" [label="测试失败"];
        "Build complete" [label="构建完成"];
        "Stuck on error" [label="被错误卡住"];
    }

    // 流程结构模板
    subgraph cluster_structure {
        label="流程结构模板";

        "Trigger: Something happens" [label="某件事触发流程", shape=ellipse];
        "Initial check?" [label="通过初次检查?", shape=diamond];
        "Main action" [label="主要操作", shape=box];
        "git status" [shape=plaintext];
        "Another check?" [label="通过第二次检查?", shape=diamond];
        "Alternative action" [label="备用操作", shape=box];
        "STOP: Don't do this" [label="停止！不要执行", shape=octagon, style=filled, fillcolor=red, fontcolor=white];
        "Process complete" [label="流程完成", shape=doublecircle];

        "Trigger: Something happens" -> "Initial check?";
        "Initial check?" -> "Main action" [label="是"];
        "Initial check?" -> "Alternative action" [label="否"];
        "Main action" -> "git status";
        "git status" -> "Another check?";
        "Another check?" -> "Process complete" [label="通过"];
        "Another check?" -> "STOP: Don't do this" [label="有问题"];
        "Alternative action" -> "Process complete";
    }

    // 根据用途选择形状
    subgraph cluster_shape_rules {
        label="各形状的适用条件";

        "Choosing a shape" [label="选择形状", shape=ellipse];

        "Is it a decision?" [label="这是决策吗?", shape=diamond];
        "Use diamond" [label="用菱形", shape=diamond, style=filled, fillcolor=lightblue];

        "Is it a command?" [label="这是命令吗?", shape=diamond];
        "Use plaintext" [label="用纯文本", shape=plaintext, style=filled, fillcolor=lightgray];

        "Is it a warning?" [label="这是警告吗?", shape=diamond];
        "Use octagon" [label="用八边形", shape=octagon, style=filled, fillcolor=pink];

        "Is it entry/exit?" [label="这是起点或终点吗?", shape=diamond];
        "Use doublecircle" [label="用双圆", shape=doublecircle, style=filled, fillcolor=lightgreen];

        "Is it a state?" [label="这是状态吗?", shape=diamond];
        "Use ellipse" [label="用椭圆", shape=ellipse, style=filled, fillcolor=lightyellow];

        "Default: use box" [label="默认用方框", shape=box, style=filled, fillcolor=lightcyan];

        "Choosing a shape" -> "Is it a decision?";
        "Is it a decision?" -> "Use diamond" [label="是"];
        "Is it a decision?" -> "Is it a command?" [label="否"];
        "Is it a command?" -> "Use plaintext" [label="是"];
        "Is it a command?" -> "Is it a warning?" [label="否"];
        "Is it a warning?" -> "Use octagon" [label="是"];
        "Is it a warning?" -> "Is it entry/exit?" [label="否"];
        "Is it entry/exit?" -> "Use doublecircle" [label="是"];
        "Is it entry/exit?" -> "Is it a state?" [label="否"];
        "Is it a state?" -> "Use ellipse" [label="是"];
        "Is it a state?" -> "Default: use box" [label="否"];
    }

    // 正确与错误示例
    subgraph cluster_examples {
        label="正确与错误示例";

        // 正确示例，标签具体且形状合适
        "Test failed" [label="测试失败", shape=ellipse];
        "Read error message" [label="读取错误消息", shape=box];
        "Can reproduce?" [label="可以复现吗?", shape=diamond];
        "git diff HEAD~1" [shape=plaintext];
        "NEVER ignore errors" [label="严禁忽略错误", shape=octagon, style=filled, fillcolor=red, fontcolor=white];

        "Test failed" -> "Read error message";
        "Read error message" -> "Can reproduce?";
        "Can reproduce?" -> "git diff HEAD~1" [label="是"];

        // 错误示例，标签含糊且形状不对
        bad_1 [label="有点问题", shape=box];  // 应使用椭圆（表示状态）
        bad_2 [label="修一下", shape=box];  // 表述太含糊
        bad_3 [label="检查", shape=box];  // 应使用菱形
        bad_4 [label="运行命令", shape=box];  // 应使用纯文本写出实际命令

        bad_1 -> bad_2;
        bad_2 -> bad_3;
        bad_3 -> bad_4;
    }
}
